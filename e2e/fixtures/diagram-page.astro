import Diagram from '../../apps/site/src/components/Diagram.astro';
import { viewFixture, viewFixtureMini } from './view-fixture.ts';
---

<StarlightPage frontmatter={{ title: 'Diagram view fixtures', pagefind: false }}>
  <Diagram diagram={viewFixture} />
